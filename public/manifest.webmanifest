    },
    {
      "src": "/github-app-manager/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/github-app-manager/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
